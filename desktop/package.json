{
  "name": "egdata-desktop",
  "version": "1.3.6",
  "description": "Secure desktop client for egdata.app",
  "productName": "egdata.app",
  "author": "egdata.app",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "native:build": "node scripts/build-native.mjs",
    "native:build:all": "node scripts/build-native.mjs --arch=all",
    "build": "pnpm run native:build && electron-vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "package": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@egdata/manifests-parser": "1.0.10",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-store": "0.11.0",
    "@tanstack/store": "0.11.0",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "semver": "7.8.5",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@egdata/manifests-parser-darwin-arm64": "1.0.10",
    "@egdata/manifests-parser-darwin-x64": "1.0.10",
    "@egdata/manifests-parser-win32-arm64-msvc": "1.0.10",
    "@egdata/manifests-parser-win32-x64-msvc": "1.0.10"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
